      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# Importar el modelo QRC\n",
        "import sys\n",
        "sys.path.append('../src')  # Ruta relativa al notebook\n",
        "from nexus_layer2_quantum_swaptions import QRCSwaptionForecaster, load_and_prepare_data\n",
        "\n",
        "# Configuración de gráficos\n",
        "plt.style.use('seaborn-v0_8-darkgrid')\n",
        "sns.set_palette(\"husl\")\n",
        "\n",
        "print(\"Dependencias cargadas\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Gc1SjMs96cH6"
      },
      "source": [
        "## 2. Cargar Datos"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "5lmnKDat6cH7"
      },
      "outputs": [],
      "source": [
        "# Cargar el dataset de swaptions\n",
        "DATA_PATH = 'sample_Swaption_Price_data_sample.csv'  # Ajusta la ruta\n",
        "\n",
        "print(\"Cargando datos...\")\n",
        "X_train, y_train, X_missing, idx_missing, X_future, dates_future, feature_cols = \\\n",
        "    load_and_prepare_data(DATA_PATH)\n",
        "\n",
        "print(f\"Datos cargados:\")\n",
        "print(f\"Training samples: {len(X_train)}\")\n",
        "print(f\"Features: {len(feature_cols)}\")\n",
        "print(f\"Future predictions: {len(X_future) if X_future is not None else 0}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "GCSaTLET6cH7"
      },
      "source": [
        "## 3. Entrenar Modelo QRC"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "mhyVD3O26cH8"
      },
      "outputs": [],
      "source": [
        "print(\"Entrenando Quantum Reservoir Computer...\")\n",
        "print(\"   Configuración:\")\n",
        "print(\"   - Qubits: 6\")\n",
        "print(\"   - Entanglement depth: 2\")\n",
        "print(\"   - Regularización Ridge: α=1.0\")\n",
        "print()\n",
        "\n",
        "# Entrenar modelo\n",
        "model = QRCSwaptionForecaster(\n",
        "    n_qubits=6,\n",
        "    entanglement_depth=2,\n",
        "    alpha=1.0\n",
        ")\n",
        "\n",
        "model.fit(X_train, y_train)\n",
        "print(\"\\nModelo entrenado\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "IZ4ujnIo6cH8"
      },
      "source": [
        "## 4. Calcular Accuracy en Training Set"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "q586LoG56cH9"
      },
      "outputs": [],
      "source": [
        "# Predicciones en training set\n",
        "y_pred_train = model.predict(X_train)\n",
        "\n",
        "# Calcular métricas\n",
        "mse = mean_squared_error(y_train, y_pred_train)\n",
        "rmse = np.sqrt(mse)\n",
        "mae = mean_absolute_error(y_train, y_pred_train)\n",
        "r2 = r2_score(y_train.flatten(), y_pred_train.flatten())\n",
        "\n",
        "# Accuracy como % (basado en error relativo)\n",
        "mape = np.mean(np.abs((y_train - y_pred_train) / (y_train + 1e-10))) * 100\n",
        "accuracy = 100 - mape\n",
        "\n",
        "print(\"=\"*60)\n",
        "print(\" MÉTRICAS DE ACCURACY - TRAINING SET\")\n",
        "print(\"=\"*60)\n",
        "print(f\"\\n  Mean Squared Error (MSE):     {mse:.6f}\")\n",
        "print(f\"  Root Mean Squared Error (RMSE): {rmse:.6f}\")\n",
        "print(f\"  Mean Absolute Error (MAE):      {mae:.6f}\")\n",
        "print(f\"  R² Score:                       {r2:.4f}\")\n",
        "print(f\"  Mean Absolute % Error (MAPE):   {mape:.2f}%\")\n",
        "print(f\"\\n  ACCURACY:                     {accuracy:.2f}%\")\n",
        "print(\"\\n\" + \"=\"*60)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "LXNp_H5l6cH9"
      },
      "source": [
        "## 5. Visualización de Predicciones vs Real"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "GCVM3HUR6cH-"
      },
      "outputs": [],
      "source": [
        "# Seleccionar algunas features para visualizar\n",
        "n_features_to_plot = 5\n",
        "features_idx = np.linspace(0, len(feature_cols)-1, n_features_to_plot, dtype=int)\n",
        "\n",
